          "allowed_values_or_units": "Date (YYYY-MM-DD)",
          "notes": "Standard ISO format"
        },
        {
          "variable_name": "time",
          "data_type": "string",
          "description": "Time of collision",
          "source": "DfT STATS19",
          "allowed_values_or_units": "Time (HH:MM)",
          "notes": "24-hour clock"
        },
        {
          "variable_name": "collision_severity",
          "data_type": "string",
          "description": "Maximum severity of any casualty involved",
          "source": "DfT STATS19",
          "allowed_values_or_units": "Categorical ('Fatal', 'Serious', 'Slight')",
          "notes": "Key road safety performance metric"
        },
        {
          "variable_name": "number_of_vehicles",
          "data_type": "integer",
          "description": "Number of motorized and non-motorized vehicles involved",
          "source": "DfT STATS19",
          "allowed_values_or_units": "Positive integer (>= 1)",
          "notes": "Measure of multi-vehicle involvement"
        },
        {
          "variable_name": "number_of_casualties",
          "data_type": "integer",
          "description": "Total casualties resulting from the collision",
          "source": "DfT STATS19",
          "allowed_values_or_units": "Positive integer (>= 1)",
          "notes": "Direct injury count"
        },
        {
          "variable_name": "speed_limit",
          "data_type": "integer",
          "description": "Posted permanent speed limit at collision site",
          "source": "DfT STATS19",
          "allowed_values_or_units": "mph (20, 30, 40, 50, 60, 70)",
          "notes": "High-speed rural lanes correlate with severity"
        },
        {
          "variable_name": "road_type",
          "data_type": "string",
          "description": "Road layout at collision location",
          "source": "DfT STATS19",
          "allowed_values_or_units": "Categorical ('Single carriageway', 'Dual carriageway', 'Roundabout', 'One way street')",
          "notes": "Identifies junction vs link risk"
        },
        {
          "variable_name": "light_conditions",
          "data_type": "string",
          "description": "Natural and artificial illumination state",
          "source": "DfT STATS19",
          "allowed_values_or_units": "Categorical ('Daylight', 'Darkness - lights lit', 'Darkness - no lighting')",
          "notes": "Evaluates unlit rural road risk"
        },
        {
          "variable_name": "weather_conditions",
          "data_type": "string",
          "description": "Atmospheric weather state at collision time",
          "source": "DfT STATS19",
          "allowed_values_or_units": "Categorical ('Fine no high winds', 'Raining', 'Fog or mist', 'Snowing')",
          "notes": "Environmental risk modifier"
        },
        {
          "variable_name": "road_surface_conditions",
          "data_type": "string",
          "description": "Pavement surface condition",
          "source": "DfT STATS19",
          "allowed_values_or_units": "Categorical ('Dry', 'Wet or damp', 'Snow', 'Frost or ice')",
          "notes": "Friction / skid risk factor"
        },
        {
          "variable_name": "urban_or_rural_area",
          "data_type": "string",
          "description": "DfT urban/rural classification",
          "source": "DfT STATS19",
          "allowed_values_or_units": "Categorical ('Urban', 'Rural')",
          "notes": "Based on settlement population thresholds"
        }
      ]
