        {
          "variable_name": "highway",
          "data_type": "string",
          "description": "OSM highway tag or proposed footpath upgrade",
          "source": "OSM / Client Track",
          "allowed_values_or_units": "Text",
          "notes": "e.g. 'unclassified', 'tertiary', 'cycleway', 'bridleway', 'footpath_upgrade'"
        },
        {
          "variable_name": "surface",
          "data_type": "string",
          "description": "Pavement surface condition",
          "source": "OSM / Aerial Photography",
          "allowed_values_or_units": "Text (e.g. 'asphalt', 'unpaved', 'gravel')",
          "notes": "Recorded from OSM extra tags"
        },
        {
          "variable_name": "length_km",
          "data_type": "numeric",
          "description": "Length of the segment in kilometres",
          "source": "Spatial Calculation (BNG)",
          "allowed_values_or_units": "km (>= 0.0)",
          "notes": "Strictly continuous 2D planar length"
        }
      ]
    },
