    {
      "dataset_id": "north_south_corridor",
      "dataset_name": "North-South Greenway (v1/v2)",
      "status": "Active / QA",
      "format": "GeoJSON / KML",
      "source_agency": "Active Travel England / HS2 / John Grimshaw",
      "open_status": "Open (Project Archive)",
      "coverage": "London to Birmingham, Stoke, Liverpool, Manchester",
      "description": "Primary spine of the proposed national cycling and walking corridor along HS2 civil engineering works and regional connections.",
      "fields": [
        {
          "variable_name": "id",
          "data_type": "integer",
          "description": "Unique identifier for each link or intervention point",
          "source": "Project Pipeline",
          "allowed_values_or_units": "Positive integer",
          "notes": "Primary key"
        },
        {
          "variable_name": "name",
          "data_type": "string",
          "description": "Descriptive name of the route link or junction treatment",
          "source": "KML / Client Route Plan",
          "allowed_values_or_units": "Text",
          "notes": "e.g. 'Link 202', 'Pear Tree Farm Footpath Upgrade'"
        },
        {
          "variable_name": "link_id",
          "data_type": "string",
          "description": "Standardized corridor link code",
          "source": "Client / Pipeline",
          "allowed_values_or_units": "Text (e.g. '202', 'V2-CH01')",
          "notes": "Prefixed with V2- for client re-alignments"
        },
        {
          "variable_name": "section",
          "data_type": "string",
          "description": "Corridor section identifier or regional segment name",
          "source": "KML Section Plan",
          "allowed_values_or_units": "Text (e.g. '1'..'35', 'Northwest', 'South of London')",
          "notes": "Defines macro corridor stage"
        },
        {
          "variable_name": "category",
          "data_type": "string",
          "description": "Functional route intervention category",
          "source": "ATE / Client Schema",
          "allowed_values_or_units": "Categorical",
          "notes": "e.g. 'Cycleway beside HS2', 'Traffic-free path away from highway', '20mph and traffic calmed or protected cycle lane', 'Old active travel route alignment'"
        },
        {
          "variable_name": "classification",
          "data_type": "string",
          "description": "Engineering intervention classification",
          "source": "Client Specification",
          "allowed_values_or_units": "Categorical",
          "notes": "e.g. 'HS2 Haulage', 'New Greenway', 'Upgrade PROW', 'Quiet Lane', 'Local Road Quietway', 'Existing routes', 'Old active travel route alignment'"
        },
        {
          "variable_name": "developer",
          "data_type": "string",
          "description": "Anticipated delivery organisation or authority",
          "source": "Client Dataset",
          "allowed_values_or_units": "Categorical",
          "notes": "e.g. 'HS2', 'Local Authority', 'National Trust', 'Sustrans', 'Canals & River Trust', 'DfT'"
        },
        {
          "variable_name": "setting",
          "data_type": "string",
          "description": "Landscape setting",
          "source": "Spatial Analysis",
          "allowed_values_or_units": "Categorical ('Rural', 'Urban', 'Suburban')",
          "notes": "Derived from ONS settlement boundaries"
        },
        {
          "variable_name": "length_km",
          "data_type": "numeric",
          "description": "Length of the segment in kilometres",
          "source": "Spatial Calculation (BNG)",
          "allowed_values_or_units": "km (>= 0.0)",
          "notes": "Computed using EPSG:27700 planar length"
        },
        {
          "variable_name": "folder",
          "data_type": "string",
          "description": "Thematic group or route cluster",
          "source": "KML Hierarchy",
          "allowed_values_or_units": "Text",
          "notes": "e.g. 'HS2 Alignment', 'Averte Verte', 'Cheshire Lanes - Swanley Bypass (v2)', 'Superseded'"
        },
        {
          "variable_name": "layer_type",
          "data_type": "string",
          "description": "Geometry layer classification",
          "source": "Pipeline",
          "allowed_values_or_units": "Categorical ('active_route', 'hs2_railway', 'point_treatment')",
          "notes": "Used for frontend styling and filtering"
        },
        {
          "variable_name": "status",
          "data_type": "string",
          "description": "Lifecycle and appraisal status of the alignment",
          "source": "Pipeline",
          "allowed_values_or_units": "Categorical ('preferred', 'alternative', 'superseded')",
          "notes": "Preferred = primary spine; Alternative = comparative/interim route (e.g. AV Direct, Sevenoaks West); Superseded = decommissioned route"
        },
        {
          "variable_name": "remarks",
          "data_type": "string",
          "description": "Contextual rationale, engineering notes, and QA audit details",
          "source": "Client / Pipeline",
          "allowed_values_or_units": "Text",
          "notes": "Detailed audit history"
        }
      ]
    },
    {
      "dataset_id": "custom_gpx",
