        {
          "variable_name": "feature_type",
          "data_type": "string",
          "description": "Matched physical infrastructure type",
          "source": "Pipeline",
          "allowed_values_or_units": "Categorical ('off-road', 'road', 'track', 'traffic_free')",
          "notes": "Classified via STRtree nearest neighbour matching"
